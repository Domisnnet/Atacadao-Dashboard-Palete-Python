# Define as cores para o terminal (ajuda na legibilidade)
GREEN  := $(shell tput -Txterm setaf 2)
YELLOW := $(shell tput -Txterm setaf 3)
CYAN   := $(shell tput -Txterm setaf 6)
RESET  := $(shell tput -Txterm sgr0)

.PHONY: help setup install start clean

# Comando padrão ao digitar apenas "make"
help:
	@echo ""
	@echo "$(CYAN)📦 Atacadão Dashboard de Paletes - Comandos Disponíveis$(RESET)"
	@echo ""
	@echo "  $(GREEN)make setup$(RESET)    - Cria o ambiente virtual (venv) e instala as bibliotecas Python"
	@echo "  $(GREEN)make install$(RESET)  - Instala os scripts auxiliares do Node.js (opcional)"
	@echo "  $(GREEN)make start$(RESET)    - Inicia o Dashboard localmente via Streamlit"
	@echo "  $(GREEN)make clean$(RESET)    - Remove arquivos temporários e caches do Python"
	@echo ""

# 1. Configura o ambiente Python
setup:
	@echo "$(YELLOW)🐍 Criando ambiente virtual...$(RESET)"
	python -m venv venv
	@echo "$(YELLOW)📥 Instalando dependências (Pandas, Streamlit, Plotly)...$(RESET)"
	@# O comando abaixo tenta o caminho do Windows (Scripts). Se falhar, tenta o Linux/Mac (bin).
	@venv/Scripts/pip install -r requirements.txt || venv/bin/pip install -r requirements.txt
	@echo "$(GREEN)✅ Ambiente Python pronto para uso!$(RESET)"

# 2. Instala as dependências do Node (para quem for usar o npm run start)
install:
	@echo "$(YELLOW)📦 Instalando auxiliares do Node.js (cross-env, rimraf)...$(RESET)"
	npm install
	@echo "$(GREEN)✅ Auxiliares do Node.js instalados!$(RESET)"

# 3. Roda o Dashboard
start:
	@echo "$(CYAN)🚀 Iniciando o Dashboard... Acesse http://localhost:8501$(RESET)"
	streamlit run app/main.py

# 4. Limpa os arquivos de cache
clean:
	@echo "$(YELLOW)🧹 Removendo arquivos temporários...$(RESET)"
	rm -rf .ipynb_checkpoints __pycache__ app/__pycache__ src/__pycache__
	@echo "$(GREEN)✅ Limpeza concluída!$(RESET)"
  